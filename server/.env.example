# Скопируй в server/.env и заполни своими значениями из личного кабинета ЮKassa.
# .env никогда не коммитится в git.

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Цена Premium в рублях (должна совпадать с config.js на фронте)
PREMIUM_PRICE_RUB=149

# Домен сайта (для CORS и return_url)
ALLOWED_ORIGIN=https://example.ru
SITE_URL=https://example.ru/

PORT=3000
DATA_FILE=./data.json
